# Groups the user created during installation is added to (one group per line).
# Read by the installer (nos-install) and the first-boot screen (nos-firstboot); groups
# not present in the image are skipped. When a new group is added, give it to the existing user by hand:
#   sudo usermod -aG <group> <user>   (then reboot)
wheel     # sudo
libvirt   # manage virtual machines without a password (virt-manager)
keyd      # per-window key remapping (keyd-application-mapper)
gamemode  # GameMode's CPU priority settings
