#!/usr/bin/env bash
# nos first-boot setup screen. Runs on tty1 on first boot, before the login screen
# (nos-firstboot.service).
#
# Flow: all questions are asked first, then a summary is shown and confirmation is asked;
# nothing on the system changes before that confirmation. The apply steps are written to
# be re-runnable: if a step fails, the user can retry or start over. The done marker
# (/var/lib/nos/firstboot-done) is only written once every step has succeeded; if setup is
# interrupted (e.g. a power cut), the screen comes back on the next boot.
#
# The root account stays locked; the created user is added to the groups in
# /usr/share/nos/user-groups (wheel: sudo, libvirt: virtual machines, etc.).

set -uo pipefail

STATE_DIR=/var/lib/nos
DONE="$STATE_DIR/firstboot-done"
STARTED="$STATE_DIR/firstboot-started"

ACCENT=4 # Blue (the text console has 16 colors)

# Don't let Ctrl+C close the screen and leave the system without a user.
trap '' INT TERM QUIT TSTP

# Systems that came via switch: if setup never started and a regular user already
# exists, don't ask anything.
if [[ ! -e "$STARTED" ]] && getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { f = 1 } END { exit !f }'; then
  mkdir -p "$STATE_DIR"
  touch "$DONE"
  exit 0
fi

# The console's default font lacks Turkish letters (ğ, ş, ı, İ).
setfont eurlatgr 2>/dev/null || true

# --- Helpers -------------------------------------------------------------------

header() {
  clear
  gum style --border normal --border-foreground "$ACCENT" --padding "0 2" --margin "1 2" \
    --bold "nos - first-time setup" "$1"
}

error() {
  gum style --foreground 1 --margin "0 2" "$@"
}

# gum returns empty on Esc/Ctrl+C; we don't accept an empty answer and repeat the question.

ask_timezone() {
  header "Time zone (type to search, arrow keys to select, Enter)"
  local tz
  while :; do
    tz=$({ echo "Europe/Istanbul"; timedatectl list-timezones | grep -vx "Europe/Istanbul"; } |
      gum filter --height 15 --placeholder "Search..." --padding "0 2") || true
    [[ -n "$tz" ]] && break
  done
  TIMEZONE="$tz"
}

ask_language() {
  header "System language"
  local choice
  while :; do
    choice=$(gum choose --padding "0 2" --selected "Turkish" "Turkish" "English") || true
    [[ -n "$choice" ]] && break
  done
  case "$choice" in
    Turkish) LOCALE=tr_TR.UTF-8 DEFAULT_KEYMAP=trq ;;
    English) LOCALE=en_US.UTF-8 DEFAULT_KEYMAP=us ;;
  esac
}

ask_keymap() {
  header "Keyboard layout"
  local -A keymaps=(["Turkish Q"]=trq ["Turkish F"]=trf ["English (US)"]=us)
  local default_label choice
  for default_label in "${!keymaps[@]}"; do
    [[ "${keymaps[$default_label]}" == "$DEFAULT_KEYMAP" ]] && break
  done
  while :; do
    choice=$(gum choose --padding "0 2" --selected "$default_label" \
      "Turkish Q" "Turkish F" "English (US)" "Other...") || true
    [[ -n "$choice" ]] && break
  done
  if [[ "$choice" == "Other..." ]]; then
    header "Keyboard layout (type to search)"
    while :; do
      KEYMAP=$(localectl list-keymaps | gum filter --height 15 --placeholder "Search..." --padding "0 2") || true
      [[ -n "$KEYMAP" ]] && break
    done
  else
    KEYMAP="${keymaps[$choice]}"
  fi
  # Apply the chosen layout right away so the following questions get the right characters.
  loadkeys "$KEYMAP" 2>/dev/null || true
}

ask_hostname() {
  header "Hostname (shown with this name on the network)"
  local name value="${HOSTNAME_VALUE:-nos}"
  while :; do
    name=$(gum input --padding "0 2" --value "$value" --char-limit 63 \
      --placeholder "e.g. bekir-pc") || true
    name="${name,,}"
    if [[ "$name" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
      break
    fi
    error "Invalid name: use lowercase letters, digits and -; it can't start or end with -."
    value="$name"
  done
  HOSTNAME_VALUE="$name"
}

ask_username() {
  header "Username (for login and the home directory; lowercase)"
  local name uid value="${USERNAME:-}"
  while :; do
    name=$(gum input --padding "0 2" --value "$value" --char-limit 32 \
      --placeholder "e.g. bekir") || true
    if [[ ! "$name" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
      error "Invalid name: use lowercase letters, digits, - and _; must start with a letter."
    elif uid=$(getent passwd "$name" | cut -d: -f3) && [[ -n "$uid" ]] &&
      { ((uid < 1000 || uid >= 60000)) || [[ ! -e "$STARTED" ]]; }; then
      # System accounts are never accepted. A regular user is accepted only when continuing
      # an unfinished setup (the account is updated then).
      error "This name already exists on the system, choose another one."
    else
      break
    fi
    value="$name"
  done
  USERNAME="$name"
}

ask_fullname() {
  header "Display name (shown on the login screen; optional)"
  local name
  name=$(gum input --padding "0 2" --value "${FULLNAME:-${USERNAME^}}" --char-limit 64) || true
  FULLNAME="${name//:/}"
}

ask_password() {
  local p1 p2
  while :; do
    header "Password ($USERNAME)"
    p1=$(gum input --padding "0 2" --password --placeholder "Password") || true
    if [[ -z "$p1" ]]; then
      error "The password can't be empty."
      sleep 1.5
      continue
    fi
    p2=$(gum input --padding "0 2" --password --placeholder "Password (again)") || true
    if [[ "$p1" != "$p2" ]]; then
      error "The passwords don't match, try again."
      sleep 1.5
      continue
    fi
    break
  done
  PASSWORD="$p1"
}

summary() {
  header "Summary"
  gum style --margin "0 2" \
    "Time zone    : $TIMEZONE" \
    "Language     : $LOCALE" \
    "Keyboard     : $KEYMAP" \
    "Hostname     : $HOSTNAME_VALUE" \
    "Username     : $USERNAME" \
    "Display name : ${FULLNAME:-(none)}" \
    "Shell        : fish" \
    "Snapshots    : home directory, daily (last 3 days + last 2 weeks)"
  echo
  gum confirm --padding "0 2" --affirmative "Install" --negative "Start over" "Is everything correct?"
}

# --- Apply steps (all re-runnable) ---------------------------------------------

apply_timezone() { timedatectl set-timezone "$TIMEZONE"; }
apply_locale() { localectl set-locale "LANG=$LOCALE"; }
apply_keymap() {
  localectl set-keymap "$KEYMAP" &&
    { grep -q '^FONT=' /etc/vconsole.conf 2>/dev/null || echo "FONT=eurlatgr" >>/etc/vconsole.conf; }
}
apply_hostname() { hostnamectl set-hostname "$HOSTNAME_VALUE"; }

# Show the boot menu for 5 seconds (to be able to pick Windows or a previous nos version).
# bootc wants to write "timeout 5" but only if loader.conf doesn't exist; during install
# systemd-boot first creates a loader.conf with the lines commented out (#), so the menu
# never shows up. bootc doesn't touch this file afterwards.
# The EFI partition is found the way bootc picks it: the first EFI partition on the system
# disk. /boot is not assumed to be mounted: if the partition is mounted somewhere, that is
# used (temporarily made writable if read-only), otherwise it's mounted under /run temporarily.
ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
apply_bootmenu() {
  local root_dev disk esp mnt="" tmp="" ro=0 rc=0 conf
  root_dev=$(findmnt -no SOURCE /sysroot | sed 's/\[.*//')
  disk=$(lsblk -no PKNAME "$root_dev" | head -n1)
  [[ -n "$disk" ]] || return 0
  esp=$(lsblk -lnpo PATH,PARTTYPE "/dev/$disk" | awk -v t="$ESP_TYPE" 'tolower($2) == t { print $1; exit }')
  [[ -n "$esp" ]] || return 0

  mnt=$(findmnt -no TARGET -S "$esp" | head -n1)
  if [[ -n "$mnt" ]]; then
    if findmnt -no OPTIONS -T "$mnt" | tr ',' '\n' | grep -qx ro; then
      ro=1
      mount -o remount,rw "$mnt" || return 1
    fi
  else
    tmp=$(mktemp -d /run/nos-esp.XXXXXX)
    mount "$esp" "$tmp" || { rmdir "$tmp"; return 1; }
    mnt="$tmp"
  fi

  conf="$mnt/loader/loader.conf"
  if [[ -f "$conf" ]] && ! grep -q '^timeout' "$conf"; then
    { printf 'timeout 5\n'; grep -v '^#\?timeout' "$conf"; } >"$conf.new" &&
      mv "$conf.new" "$conf" || rc=1
  fi

  if [[ -n "$tmp" ]]; then
    umount "$tmp" && rmdir "$tmp"
  elif ((ro)); then
    mount -o remount,ro "$mnt"
  fi
  return $rc
}

# On btrfs the root directory of a subvolume always has inode number 256.
home_is_subvolume() { [[ "$(stat -c %i /var/home 2>/dev/null)" == 256 ]]; }

# Snapshots can only be taken of btrfs subvolumes, but bootc creates /var/home as a plain
# directory. Before the user is created, while the directory is still empty, it's turned
# into a subvolume. Left alone if not btrfs or if the directory isn't empty (not expected).
apply_home_subvolume() {
  [[ "$(findmnt -no FSTYPE -T /var)" == btrfs ]] || return 0
  home_is_subvolume && return 0
  if [[ -d /var/home ]]; then
    [[ -z "$(ls -A /var/home)" ]] || return 0
    rmdir /var/home
  fi
  btrfs subvolume create /var/home && chmod 0755 /var/home
}

# Automatic snapshots of the home directory: last 3 days and last 2 weeks. The user can use
# snapper and /home/.snapshots without sudo.
apply_snapper() {
  home_is_subvolume || return 0
  [[ -e /etc/snapper/configs/home ]] || snapper -c home create-config /var/home
  snapper -c home set-config \
    TIMELINE_CREATE=yes TIMELINE_CLEANUP=yes \
    TIMELINE_LIMIT_HOURLY=0 TIMELINE_LIMIT_DAILY=3 TIMELINE_LIMIT_WEEKLY=2 \
    TIMELINE_LIMIT_MONTHLY=0 TIMELINE_LIMIT_YEARLY=0 \
    ALLOW_USERS="$USERNAME" SYNC_ACL=yes
}

# Groups from /usr/share/nos/user-groups (same list as the installer); missing ones are skipped.
user_groups() {
  local g groups=
  for g in $(cut -d'#' -f1 /usr/share/nos/user-groups 2>/dev/null || echo wheel); do
    getent group "$g" >/dev/null && groups+="$g,"
  done
  echo "${groups%,}"
}

apply_user() {
  if getent passwd "$USERNAME" >/dev/null; then
    usermod -a -G "$(user_groups)" -s /usr/bin/fish -c "$FULLNAME" "$USERNAME"
  else
    useradd -m -G "$(user_groups)" -s /usr/bin/fish -c "$FULLNAME" "$USERNAME"
  fi
}
apply_password() { printf '%s:%s\n' "$USERNAME" "$PASSWORD" | chpasswd; }

# Runs a step; if it fails, asks the user what to do.
# Returns: 0 = success, 1 = the user wants to start over.
run_step() {
  local title="$1" fn="$2" out
  while :; do
    if out=$("$fn" 2>&1); then
      gum style --margin "0 2" "[ok] $title"
      return 0
    fi
    error "[ERROR] $title failed:" "$out"
    echo
    if gum confirm --padding "0 2" --affirmative "Retry" --negative "Start over" "What now?"; then
      continue
    fi
    return 1
  done
}

apply_all() {
  header "Installing..."
  run_step "Time zone" apply_timezone &&
    run_step "Language" apply_locale &&
    run_step "Keyboard" apply_keymap &&
    run_step "Hostname" apply_hostname &&
    run_step "Boot menu (5 s)" apply_bootmenu &&
    run_step "Home directory (for snapshots)" apply_home_subvolume &&
    run_step "User" apply_user &&
    run_step "Password" apply_password &&
    run_step "Automatic snapshots" apply_snapper
}

# --- Main flow -----------------------------------------------------------------

while :; do
  ask_timezone
  ask_language
  ask_keymap
  ask_hostname
  ask_username
  ask_fullname
  ask_password
  summary || continue

  mkdir -p "$STATE_DIR"
  touch "$STARTED"
  if apply_all; then
    break
  fi
done

touch "$DONE"
rm -f "$STARTED"
unset PASSWORD
echo
gum style --margin "0 2" --foreground 2 --bold "Done! Opening the login screen..."
sleep 2
