[Unit]
Description=Download the nos update (applied on next boot)
Documentation=man:bootc-upgrade(8)
# Run only on systems booted with bootc (composefs). bootc's own
# bootc-fetch-apply-updates checks /run/ostree-booted; that file doesn't exist with composefs.
# Depending on the version, bootc writes "composefs.digest=..." or "composefs=..." to the
# kernel command line; with "|" either one is enough.
ConditionKernelCommandLine=|composefs.digest
ConditionKernelCommandLine=|composefs
Wants=network-online.target
After=network-online.target
# On failure (e.g. a brief internet drop) it retries after 15 min; at most 4 attempts
# in 2 hours, then it waits for the next timer run.
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Type=oneshot
# No --apply: bootc downloads and stages the update, it does not reboot the computer.
# The staged version takes effect on the next boot.
ExecStart=/usr/bin/bootc upgrade --quiet
Restart=on-failure
RestartSec=15min
# Run in the background without slowing down the desktop.
Nice=19
IOSchedulingClass=idle
