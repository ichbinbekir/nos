// nos fastfetch config (system-wide). If the user writes their own config to
// ~/.config/fastfetch/config.jsonc, that one is used instead of this file.
// The logo is generated with tools/logo-gen.py; the colors must match the ones there.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/nos/fastfetch-logo.txt",
    "color": {
      "1": "94",       // body: light blue
      "2": "97",       // letters and arrow: white
      "3": "38;5;208", // label: orange
      "4": "90",       // handle: dark gray
      "5": "37"        // valve: chrome
    }
  },
  "display": {
    "color": {
      "keys": "94",
      "title": "94"
    }
  },
  // When a config file exists and "modules" is not set, fastfetch shows no info at all.
  // This list is fastfetch's own default list.
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
