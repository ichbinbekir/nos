# nos-bootc: a small image containing the compiled bootc files.
# The main image (../../core/Containerfile) copies bootc from here instead of building it daily.
# Built by .github/workflows/build-bootc.yml only on a new bootc release, once a week,
# and when these files change.

FROM docker.io/archlinux/archlinux:latest AS builder

RUN pacman -Syu --noconfirm make git rust go-md2man ostree glibc pkgconf

# If empty, the latest released version is built.
ARG BOOTC_VERSION=""

WORKDIR /home/build
COPY build-bootc.sh /build-bootc.sh
RUN BOOTC_VERSION="${BOOTC_VERSION}" bash /build-bootc.sh

# The final image has no Arch or build tools, only bootc's installed files.
FROM scratch
COPY --from=builder /output /

LABEL org.opencontainers.image.title="nos-bootc"
LABEL org.opencontainers.image.description="bootc built for Arch Linux (for the nos image)"
LABEL org.opencontainers.image.source="https://github.com/ichbinbekir/nos"
