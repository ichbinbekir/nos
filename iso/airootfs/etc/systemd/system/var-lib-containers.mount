# İndirilen imaj canlı sistemin küçük yazılabilir alanına değil, RAM'de ayrı bir diske
# gitsin. tmpfs sadece yazılan kadar RAM kullanıyor; podman'in overlay deposu tmpfs'te
# çalışıyor (canlı sistemin kendi overlay'inin üstünde çalışmazdı). Açılmış imaj RAM'den
# büyük olabildiği için sınır RAM'in üstünde: sığmayan kısım sıkıştırılmış takasa (zram,
# zram-generator.conf) gider; imaj dosyaları ~2-3 kat sıkışıyor, 8 GB RAM yetiyor.
[Unit]
Description=Kurulum için imaj deposu (RAM)

[Mount]
What=tmpfs
Where=/var/lib/containers
Type=tmpfs
Options=mode=0700,size=200%

[Install]
WantedBy=local-fs.target
