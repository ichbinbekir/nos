#!/usr/bin/env bash
# GEÇİCİ ÇÖZÜM, bkz. /usr/lib/modprobe.d/nos-nvidia-rtd3-rebind.conf. NVIDIA sürücüsü
# yüklendikten hemen sonra (modprobe "install" kancası) uyku özelliğini "Not supported"
# sayan her kartı sürücüden ayırıp yeniden bağlar. Aynı anda iki kez çalışmasın diye kilitli
# (birden çok modprobe çağrısı yarışabiliyor). nvidia-powerd o sırada çalışıyorsa kartı
# kaybedip kapanıyor; yeniden başlatılır.
#
# Sürücü kartı ayrı bir iş parçacığında (nv-probe) tanıtıyor; modprobe döndüğünde kart henüz
# tanıtılmamış olabiliyor (/proc/driver/nvidia/gpus/<kart>/power yok). İlk sürüm beklemediği
# için hiçbir şey yapmadan çıkıyordu; şimdi her bağlı kart için en çok 15 sn bekleniyor.

log() { logger -t nos-nvidia-rtd3 "$*"; }

exec 9>/run/nos-nvidia-rtd3-rebind.lock
flock 9

rebound=0
for dev in /sys/bus/pci/drivers/nvidia/0000:*; do
  [[ -e $dev ]] || continue
  bdf="$(basename "$dev")"
  f="/proc/driver/nvidia/gpus/$bdf/power"

  for _ in $(seq 75); do
    grep -q 'Runtime D3 status' "$f" 2>/dev/null && break
    sleep 0.2
  done
  if ! grep -q 'Runtime D3 status' "$f" 2>/dev/null; then
    log "$bdf: 15 sn içinde tanıtılmadı, dokunulmadı"
    continue
  fi

  status="$(grep -m1 'Runtime D3 status' "$f")"
  if [[ $status != *"Not supported"* ]]; then
    log "$bdf: gerek yok (${status//  / })"
    continue
  fi

  echo "$bdf" >/sys/bus/pci/drivers/nvidia/unbind || { log "$bdf: unbind başarısız"; continue; }
  echo "$bdf" >/sys/bus/pci/drivers/nvidia/bind || { log "$bdf: bind başarısız"; continue; }
  log "$bdf: yeniden bağlandı, şimdi: $(grep -m1 'Runtime D3 status' "$f" 2>/dev/null)"
  rebound=1
done

if ((rebound)) && systemctl -q is-enabled nvidia-powerd.service 2>/dev/null; then
  systemctl --no-block restart nvidia-powerd.service
fi
exit 0
