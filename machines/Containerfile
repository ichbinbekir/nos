# Machine image (nos-<machine>): adds that machine's drivers and settings on top of the shared
# nos image (scripts/machine.sh, machines/<machine>/). The build context is the repo root.
# The shared image is not published: CI (and `just build-machine`) use localhost/nos, built
# just before in the same place.
ARG BASE_IMAGE=localhost/nos:latest

FROM scratch AS ctx
COPY scripts /scripts
COPY machines /machines

FROM ${BASE_IMAGE}

ARG MACHINE

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/usr/lib/sysimage/cache/pacman/pkg \
    --mount=type=tmpfs,dst=/run \
    --mount=type=tmpfs,dst=/tmp \
    bash /ctx/scripts/machine.sh "${MACHINE}"

LABEL containers.bootc 1

RUN bootc container lint
